#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        HML_layer: HML_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 15 12 13 14 15 16 17 24 25 26 24 25 26 28 29 27>;
            hold-trigger-on-release;
        };

        HMR_layer: HMR_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;
            hold-trigger-on-release;
        };

        HML_kp: HML_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 15 12 13 14 15 16 17 24 25 26 24 25 26 28 29 27>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        HMR_kp: HMR_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp ESC   &kp Q                 &kp W  &kp F             &kp P           &kp B           &kp J               &kp L           &kp U                &kp Y    &kp SEMICOLON          &kp BSPC
&kp TAB   &HMR_kp LEFT_SHIFT A  &kp R  &kp S             &HMR_layer 1 T  &kp G           &kp M               &HML_layer 1 N  &kp E                &kp I    &HML_kp RIGHT_SHIFT O  &kp SQT
&kp CAPS  &kp Z                 &kp X  &kp C             &kp D           &kp V           &kp K               &kp H           &kp COMMA            &kp DOT  &kp FSLH               &kp MINUS
                                       &kp LEFT_CONTROL  &kp LGUI        &kp LEFT_ALT    &mt LEFT_ALT ENTER  &lt 2 SPACE     &mt LC(LA(F21)) F12
            >;
        };

        symbols_numpad {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Num";
            bindings = <
&kp GRAVE          &kp EXCLAMATION        &kp AT           &kp HASH        &kp DOLLAR            &kp BACKSLASH       &kp KP_SUBTRACT  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp COLON     &kp BSPC
&kp TILDE          &kp PERCENT            &kp CARET        &kp AMPERSAND   &kp ASTERISK          &kp SLASH           &kp KP_PLUS      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0  &none
&kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET    &kp KP_EQUAL     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT       &none
                                                           &trans          &trans                &trans              &trans           &trans        &trans
            >;
        };

        navigation {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Nav";
            bindings = <
&bt BT_NXT  &none  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &none     &none   &none     &none     &none         &none      &kp C_VOL_UP
&bt BT_PRV  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none     &none   &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &kp C_VOL_DN
&bt BT_CLR  &none  &none           &none           &none            &none     &none   &none     &none     &none         &none      &kp C_MUTE
                                   &trans          &trans           &trans    &trans  &trans    &trans
            >;
        };
    };
};
